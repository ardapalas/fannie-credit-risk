# Ornek: bu dosyayi .env olarak kopyalayip degerleri doldurun. .env ASLA commit edilmez.

# Veri hazirlama (src/data/fetch_macro.py)
FRED_API_KEY=

# PostgreSQL (docker-compose.yml)
POSTGRES_USER=kredi
POSTGRES_PASSWORD=SIFRE_BURAYA
POSTGRES_DB=kredi_riski
POSTGRES_PORT=5432

# Backend veritabani: API varsayilan olarak bunu kullanir. Kullanici/sifre yukaridakilerle ayni olmali.
# Bu satir yoksa yerel gelistirme icin data/api.db (SQLite) kullanilir. Testler her zaman SQLite kullanir.
DATABASE_URL=postgresql+psycopg://kredi:SIFRE_BURAYA@localhost:5432/kredi_riski
